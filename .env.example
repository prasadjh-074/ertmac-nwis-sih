GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ingestion pipeline database (same Postgres instance as the main project)
INGESTION_DATABASE_URL=postgresql+psycopg2://localhost:5433/geo_intelligence
OCR_ENABLED=true
OCR_LANGUAGE=eng
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Database connection (used by db_config.py + api/config.py) ─────────
# Local dev (no Docker): leave these unset — both modules default to the
# project's existing Homebrew Postgres at localhost:5433 / geo_intelligence
# / prasadhemadri99, exactly as before this file existed.
#
# Docker Compose: these ARE required (docker-compose.yml has no built-in
# default for the password) and get read by the backend container as
# DB_HOST=postgres / DB_PORT=5432 — the compose service name and its own
# internal port, never localhost. POSTGRES_* below also seed the
# postgres container itself on first startup.
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=geo_intelligence
# DB_USER=nwis
# DB_PASSWORD=

# ── docker-compose.yml: postgres container ──────────────────────────────
POSTGRES_DB=geo_intelligence
POSTGRES_USER=nwis
POSTGRES_PASSWORD=change-me-before-first-run

# ── docker-compose.yml: backend container (optional overrides) ─────────
# API_LOG_FORMAT=json
# API_CORS_ORIGINS=
